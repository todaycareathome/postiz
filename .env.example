# System Configuration
DOMAIN=postiz.<<YourDomain>>.com
JWT_SECRET=<<Your JWT SECRET>>

# Database Configuration (Shared across Postiz and Temporal)
POSTGRES_USER=<Your database user name>>
POSTGRES_PASSWORD=<Your database user password>>
POSTGRES_DB=<Your database name>>
POSTGRES_PORT=<Your database port>>

# Basic App Settings
DISABLE_REGISTRATION=false
STORAGE_PROVIDER=local
API_LIMIT=30

# Cloudflare (Optional Storage Provider)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

# Authentik / OAuth Settings
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=Authentik
NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=https://githubusercontent.com
POSTIZ_GENERIC_OAUTH=false
POSTIZ_OAUTH_URL=https://example.com
POSTIZ_OAUTH_AUTH_URL=https://example.com/application/o/authorize
POSTIZ_OAUTH_TOKEN_URL=https://example.com/application/o/token
POSTIZ_OAUTH_USERINFO_URL=https://example.com
POSTIZ_OAUTH_CLIENT_ID=
POSTIZ_OAUTH_CLIENT_SECRET=

# Social Media API Integration Credentials (Fill out as needed)
